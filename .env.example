# HavenLink Environment Variables
# Copy this file to .env for local development (it is gitignored).
# In production, set these in AWS Secrets Manager and inject them into the runtime
# (e.g. AWS App Runner environment). NEVER commit real secret values.

# Server Configuration
PORT=3000
NODE_ENV=development

# Public base URL of the app (used to build verification links + the OAuth callback).
# Dev: http://localhost:3000   Prod: https://YOUR_DOMAIN
APP_BASE_URL=http://localhost:3000

# ---- Database (AWS RDS Postgres) --------------------------------------------
# Local dev example: postgres://postgres:postgres@localhost:5432/havenlink
# Prod (RDS): require TLS, e.g. ...amazonaws.com:5432/havenlink?sslmode=verify-full
DATABASE_URL=postgres://postgres:postgres@localhost:5432/havenlink
# Path to the RDS CA bundle for TLS verification in prod (e.g. global-bundle.pem).
# PGSSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem

# ---- Sessions ----------------------------------------------------------------
# Long random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ---- Google OAuth2 -----------------------------------------------------------
# From Google Cloud Console > Credentials > OAuth 2.0 Client ID.
# SECURITY: rotate the client secret since it was shared in plaintext; treat the
# previously pasted value as compromised.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_rotated_client_secret
# Must EXACTLY match an Authorized redirect URI registered in Google Cloud Console.
# Dev: http://localhost:3000/auth/google/callback
# Prod: https://YOUR_DOMAIN/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---- Email (nodemailer / SMTP) ----------------------------------------------
# Used for partnership requests and account email verification.
EMAIL_FROM="HavenLink <no-reply@havenlink.org>"
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ---- Gemini AI chatbot -------------------------------------------------------
# Powers the "Ask HavenLink" assistant (POST /api/chat). Optional: the app runs
# without it, but the chatbot stays disabled until a key is set.
#
# Default (recommended to start): free-tier Gemini Developer API.
#   1. Go to https://aistudio.google.com/apikey  (sign in with a Google account)
#   2. Click "Create API key", copy it, paste below.
#   Free tier for gemini-2.5-flash is ~1,500 requests/day, no credit card needed.
GEMINI_API_KEY=your_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: route through Vertex AI instead so usage bills against your GCP
# project (and your $300 free-trial credit, which does NOT apply to the AI Studio
# API). Requires Application Default Credentials (`gcloud auth application-default
# login`) and the Vertex AI API enabled on the project. Leave false to use the key
# above.
GEMINI_USE_VERTEX=false
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GEMINI_LOCATION=us-central1
# Service-account key JSON (whole file on one line) for Vertex auth where there is
# no gcloud login, e.g. AWS App Runner. Leave unset locally to use your gcloud ADC.
# GEMINI_SA_KEY={"type":"service_account","project_id":"...", ...}
