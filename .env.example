# HavenLink Environment Variables
# Copy this file to .env in your local environment (for development)
# Set these variables in AWS Amplify console for production

# Server Configuration
PORT=3000
NODE_ENV=development

# Email Configuration (for partnership request forms)
# To enable partnership request emails, set these environment variables:

# Gmail Email Address
EMAIL_USER=havenlink.org@gmail.com

# Gmail App Password
# 1. Go to https://myaccount.google.com/security
# 2. Enable "2-Step Verification" if not already enabled
# 3. Go to "App passwords" (at the bottom of the Security page)
# 4. Select "Mail" and "Windows Computer" (or your device)
# 5. Copy the generated 16-character password
# 6. Set EMAIL_PASSWORD to this password

EMAIL_PASSWORD=your_16_char_app_password_here

# Optional: Future API/Service URLs
# API_URL=https://api.havenlink.com
# LOG_LEVEL=info
