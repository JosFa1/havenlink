# HavenLink Environment Variables
# Copy this file to .env for local development (it is gitignored).
# In production, set these in AWS Secrets Manager and inject them into the runtime
# (e.g. AWS App Runner environment). NEVER commit real secret values.

# Server Configuration
PORT=3000
NODE_ENV=development

# Public base URL of the app (used to build verification links + the OAuth callback).
# Dev: http://localhost:3000   Prod: https://YOUR_DOMAIN
APP_BASE_URL=http://localhost:3000

# ---- Database (AWS RDS Postgres) --------------------------------------------
# Local dev example: postgres://postgres:postgres@localhost:5432/havenlink
# Prod (RDS): require TLS, e.g. ...amazonaws.com:5432/havenlink?sslmode=verify-full
DATABASE_URL=postgres://postgres:postgres@localhost:5432/havenlink
# Path to the RDS CA bundle for TLS verification in prod (e.g. global-bundle.pem).
# PGSSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem

# ---- Sessions ----------------------------------------------------------------
# Long random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ---- Google OAuth2 -----------------------------------------------------------
# From Google Cloud Console > Credentials > OAuth 2.0 Client ID.
# SECURITY: rotate the client secret since it was shared in plaintext; treat the
# previously pasted value as compromised.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_rotated_client_secret
# Must EXACTLY match an Authorized redirect URI registered in Google Cloud Console.
# Dev: http://localhost:3000/auth/google/callback
# Prod: https://YOUR_DOMAIN/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---- Email (nodemailer / Gmail) ---------------------------------------------
# Used for partnership requests AND account email verification.
EMAIL_USER=havenlink.org@gmail.com

# Gmail App Password (16 chars):
# 1. https://myaccount.google.com/security
# 2. Enable "2-Step Verification"
# 3. "App passwords" -> Mail -> copy the 16-char password
EMAIL_PASSWORD=your_16_char_app_password_here
