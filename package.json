{
  "name": "havenlink",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "start:migrate": "npm run migrate:prod && npm run seed:prod && npm start",
    "migrate": "node -r ts-node/register src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "seed": "node -r ts-node/register src/db/seedResources.ts && node -r ts-node/register src/db/seedCalculator.ts",
    "seed:prod": "node dist/db/seedResources.js && node dist/db/seedCalculator.js",
    "etl:resources": "node scripts/etl-resources.mjs",
    "test": "npm run build && node --test dist/calculator/calculate.test.js dist/calculator/tidePlate.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acid701/havenlink.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/acid701/havenlink/issues"
  },
  "homepage": "https://github.com/acid701/havenlink#readme",
  "dependencies": {
    "@google/genai": "^2.10.0",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.0.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  }
}
