# CI passes whichever registry answered for node:20-slim (see the deploy workflow).
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:20-slim

FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY public ./public
COPY knowledge-tools ./knowledge-tools
RUN npm run build

FROM ${NODE_IMAGE}
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/public ./public
COPY --from=build /app/src/data ./src/data
COPY --from=build /app/knowledge-tools ./knowledge-tools
COPY scripts ./scripts
# Lambda Web Adapter 0.9.1 (arm64), vendored; see vendor/aws-lambda-adapter/README.md.
COPY --chmod=0755 vendor/aws-lambda-adapter/lambda-adapter /opt/extensions/lambda-adapter
ENV PORT=3000 AWS_LWA_PORT=3000 AWS_LWA_READINESS_CHECK_PATH=/health
EXPOSE 3000
CMD ["node", "dist/app.js"]
